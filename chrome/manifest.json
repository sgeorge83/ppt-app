{
  "manifest_version": 3,
  "name": "WordOnAir Slides",
  "version": "1.0.2",
  "description": "Place World English Bible and Urdu Geo verses on PowerPoint slides. Free from WordOnAir Labs.",
  "action": {
    "default_title": "WordOnAir Slides",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "homepage_url": "https://wordonair.com",
  "permissions": ["storage"]
}
